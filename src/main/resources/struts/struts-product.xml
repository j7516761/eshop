<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.1//EN"
    "http://struts.apache.org/dtds/struts-2.1.dtd">
<struts>
	<package name="product" extends="struts-default">
		<interceptors>
			<interceptor name="ProductInterceptor" 
				class="com.example.interceptor.ProductInterceptor" />
			<interceptor-stack name="ProductStack">
			<interceptor-ref name="ProductInterceptor" />
			<interceptor-ref name="defaultStack" />
			</interceptor-stack>
		</interceptors>

		<action name="list" class="com.example.action.ProductAction"
			method="listProducts">
			<interceptor-ref name="ProductStack" />
			<result name="success">/WEB-INF/views/product/product.jsp</result>
			<result name="error">/error.jsp</result>
		</action>

		<action name="detail" class="com.example.action.ProductAction"
			method="productDetail">
			<result>/WEB-INF/views/product/productDetail.jsp</result>
		</action>
	</package>
</struts>