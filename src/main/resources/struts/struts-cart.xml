<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 2.5//EN"
    "http://struts.apache.org/dtds/struts-2.5.dtd">
<struts>
	<package name="cart" extends="struts-default">

		<action name="viewCart" class="com.example.action.CartAction"
			method="viewCart">
			<result name="success">/WEB-INF/views/cart/cart.jsp</result>
		</action>

		<action name="addToCart" class="com.example.action.CartAction"
			method="addToCart">
		</action>

		<action name="removeItem" class="com.example.action.CartAction"
			method="removeItem">
			<result name="success" type="redirectAction">/cart/viewCart</result>
		</action>

		<action name="updateQuantity"
			class="com.example.action.CartAction" method="updateQuantity">
			<result name="success" type="redirectAction">/cart/viewCart</result>
		</action>

	</package>
</struts>